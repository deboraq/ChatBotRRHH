# Copiá este archivo a .env y completá los valores.
# Para recuperar contraseña por email, el usuario debe recibir el enlace en su correo;
# para eso tenés que configurar SMTP abajo.

# --- SMTP (envío de emails, ej. recuperar contraseña) ---
# Si no configurás SMTP, el enlace de restablecimiento se muestra en pantalla para copiarlo.
SMTP_HOST=smtp.ejemplo.com
SMTP_PORT=587
SMTP_USER=no-reply@tudominio.com
SMTP_PASSWORD=tu-clave-smtp
SMTP_FROM=no-reply@tudominio.com
SMTP_USE_TLS=true

# Ejemplos por proveedor:
# Gmail (usar "Contraseña de aplicación"): SMTP_HOST=smtp.gmail.com, SMTP_PORT=587
# Outlook: SMTP_HOST=smtp.office365.com, SMTP_PORT=587
# SendGrid: SMTP_HOST=smtp.sendgrid.net, SMTP_USER=apikey, SMTP_PASSWORD=<tu API key>
