# Copiá este archivo a .env y completá los valores.
# Para recuperar contraseña por email, el usuario debe recibir el enlace en su correo;
# para eso tenés que configurar SMTP abajo.

# --- SMTP (envío de emails, ej. recuperar contraseña) ---
# Si no configurás SMTP, el enlace de restablecimiento se muestra en pantalla para copiarlo.
SMTP_HOST=smtp.ejemplo.com
SMTP_PORT=587
SMTP_USER=no-reply@tudominio.com
SMTP_PASSWORD=tu-clave-smtp
SMTP_FROM=no-reply@tudominio.com
SMTP_USE_TLS=true

# Ejemplos por proveedor:
# Gmail (usar "Contraseña de aplicación"): SMTP_HOST=smtp.gmail.com, SMTP_PORT=587
# Outlook: SMTP_HOST=smtp.office365.com, SMTP_PORT=587
# SendGrid: SMTP_HOST=smtp.sendgrid.net, SMTP_USER=apikey, SMTP_PASSWORD=<tu API key>

# --- Twilio (WhatsApp, comunicados) ---
# Consola: https://www.twilio.com/console → Account SID y Auth Token
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Número "desde" en formato whatsapp:+54911... (sandbox: ej. whatsapp:+14155238886)
TWILIO_WHATSAPP_FROM=

# --- Firebase Storage (adjuntos del panel RRHH) ---
# Nombre del bucket (Firebase Console → Storage; ej. it-analyzer.firebasestorage.app)
FIREBASE_STORAGE_BUCKET=

# --- Gemini AI (generación de FAQs desde documentos Drive/PDF) ---
# Gratis: conseguí tu API key en https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# --- N8N Webhook (auto-sync desde Google Drive) ---
# Generá un string secreto largo (ej. con: python -c "import secrets; print(secrets.token_hex(32))")
# Usá el mismo valor en el nodo HTTP Request de N8N como header X-Webhook-Secret
N8N_WEBHOOK_SECRET=
